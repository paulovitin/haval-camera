<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <permission android:name="br.com.redesurftank.havalcamera.permission.CONTROL"
        android:protectionLevel="signature" />
    <permission android:name="br.com.redesurftank.havalcamera.permission.READ_VIDEO"
        android:protectionLevel="signature" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application android:label="Câmera Haval" android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="br.com.redesurftank.havalcamera.shizuku"
            android:multiprocess="false" android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".CameraActivity" android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".VideoGalleryActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <activity android:name=".VideoPlaybackActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <activity android:name=".VideoSettingsActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <service android:name=".TripVideoService" android:exported="true"
            android:permission="br.com.redesurftank.havalcamera.permission.CONTROL" />
        <service android:name=".LocalVideoActionService" android:exported="false" />
        <provider android:name=".VideoCatalogProvider"
            android:authorities="br.com.redesurftank.havalcamera.video"
            android:exported="true"
            android:readPermission="br.com.redesurftank.havalcamera.permission.READ_VIDEO"
            android:writePermission="br.com.redesurftank.havalcamera.permission.CONTROL" />
    </application>
</manifest>
